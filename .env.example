# Required for Gemini API calls. Configure as a secret in the runtime environment.
GEMINI_API_KEY=""

# Optional Gemini model override. Keep the application default when empty.
AI_MODEL=""

# Per-attempt Gemini request timeout in milliseconds (default: 45000).
AI_REQUEST_TIMEOUT_MS="45000"

# Maximum number of attempts, including the first request (default: 2).
AI_MAX_ATTEMPTS="2"

# Initial retry backoff in milliseconds; subsequent delays are exponential (default: 1000).
AI_RETRY_INITIAL_BACKOFF_MS="1000"

# Optional local server port. Vercel Functions do not use this setting.
PORT="3000"

# Optional local Vite setting used to disable HMR and file watching.
DISABLE_HMR="false"
